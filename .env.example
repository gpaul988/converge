# Example environment variables for production (do NOT commit real secrets)
# Supabase (recommended for Netlify)
SUPABASE_URL=
SUPABASE_KEY=

# Optional admin protection (if you want to enable login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=some-long-random-secret

# If deploying to Netlify and you want to allow ephemeral file writes (not recommended)
ALLOW_FILE_PERSIST=false

# Netlify sets NETLIFY=true automatically
# NODE_ENV=production (set by Netlify during build)
